*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
service-account*.json
client_secret*.json

# Logs & Temporary files
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS and Editor metadata
.DS_Store
.DS_Store?
._*
.vscode
.idea

