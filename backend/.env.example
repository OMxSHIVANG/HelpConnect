# ==============================================================================
# HelpConnect Backend Configuration Example
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your own.
# WARNING: NEVER commit your actual .env file with production credentials to GitHub!
# ==============================================================================

# Server Environment
PORT=5001
NODE_ENV=development
SERVE_FRONTEND=false

# Trusted CORS origins (comma-separated for multiple origins)
# In production, specify exact client origins (e.g. https://helpconnect.org,https://admin.helpconnect.org)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Reverse Proxy / Load Balancer Hops (1 for Render / Cloudflare / Nginx / AWS ALB)
TRUST_PROXY=1

# Database Connection (Required)
# Local MongoDB Development:
MONGO_URI=mongodb://127.0.0.1:27017/helpconnect
# Production MongoDB Atlas Replica Set (Replace with your Atlas connection string):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/helpconnect?retryWrites=true&w=majority

# JWT Authentication (Required - Minimum 16 characters in dev, >= 32 characters in production)
# Generate a strong key with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here

# Google OAuth 2.0 (Optional - required if enabling Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Distributed Cache & Rate Limiting (Redis)
# Required for multi-instance production deployments; falls back to local memory if omitted in development
REDIS_URL=redis://127.0.0.1:6379

# Media Storage (Cloudinary - Optional, falls back to base64 data URI if omitted in development)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email & Notification Service (SMTP - Optional, falls back to console logging if omitted)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.mailgun.org
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@helpconnect.org

# Initial Admin Bootstrap (Optional - used by create-admin.js)
INITIAL_ADMIN_EMAIL=admin@helpconnect.org
INITIAL_ADMIN_PASSWORD=change_this_admin_password_immediately
