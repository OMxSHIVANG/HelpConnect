# Public Frontend Environment Configuration
# NOTE: Only variables prefixed with VITE_ are exposed to the client-side JavaScript bundle.
# NEVER place private secrets (database passwords, JWT secrets, Cloudinary API secrets,
# or SMTP passwords) in this file or any frontend configuration!

# API Base URL (Use /api for unified deployment or full URL like http://localhost:5001/api for decoupled)
VITE_API_URL=http://localhost:5001/api

# Real-Time WebSocket / Socket.IO Server URL (Optional: defaults to VITE_API_URL host if omitted)
VITE_SOCKET_URL=http://localhost:5001

# Google OAuth Client ID (Public identifier configured in Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
